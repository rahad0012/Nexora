rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is an authorized admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mdrahad0529@gmail.com" ||
        request.auth.token.email == "admin@nexora.digital" ||
        request.auth.token.email == "admin@nexora.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // News Collection
    match /news/{newsId} {
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // AI Prompts Collection
    match /aiPrompts/{promptId} {
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Technology Collection
    match /technology/{techId} {
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Free Books Collection
    match /books/{bookId} {
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Admins Collection - only admins can read, modifications restricted
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
